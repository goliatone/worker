[
  {
    "key": "shift+alt+1",
    "command": "workbench.action.terminal.focusAtIndex1",
    "when": "terminalFocus"
  },
  {
    "key": "shift+alt+2",
    "command": "workbench.action.terminal.focusAtIndex2",
    "when": "terminalFocus"
  },
  {
    "key": "shift+cmd+d",
    "command": "editor.action.copyLinesUpAction"
  },
  {
    "key": "shift+cmd+i",
    "command": "guid.insert",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+[",
    "command": "-guid.insert",
    "when": "editorTextFocus"
  }
]
