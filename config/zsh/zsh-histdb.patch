diff --git a/sqlite-history.zsh b/sqlite-history.zsh
index 32c3990..a921ef0 100644
--- a/sqlite-history.zsh
+++ b/sqlite-history.zsh
@@ -18,6 +18,7 @@ typeset -g HISTDB_INODE=()
 typeset -g HISTDB_SESSION=""
 typeset -g HISTDB_HOST=""
 typeset -g HISTDB_INSTALLED_IN="${(%):-%N}"
+typeset -g HISTDB_BUSY_TIMEOUT_MS="${HISTDB_BUSY_TIMEOUT_MS:-5000}"
 
 
 
@@ -26,7 +27,7 @@ sql_escape () {
 }
 
 _histdb_query () {
-    sqlite3 -batch -noheader -cmd ".timeout 1000" "${HISTDB_FILE}" "$@"
+    sqlite3 -batch -noheader -cmd ".timeout ${HISTDB_BUSY_TIMEOUT_MS}" "${HISTDB_FILE}" "$@"
     [[ "$?" -ne 0 ]] && echo "error in $@"
 }
 
@@ -52,7 +53,7 @@ _histdb_start_sqlite_pipe () {
     local PIPE==(<<<'')
     setopt local_options no_notify no_monitor
     mkfifo $PIPE
-    sqlite3 -batch -noheader "${HISTDB_FILE}" < $PIPE >/dev/null &|
+    sqlite3 -batch -noheader -cmd ".timeout ${HISTDB_BUSY_TIMEOUT_MS}" "${HISTDB_FILE}" < $PIPE >/dev/null &|
     sysopen -w -o cloexec -u HISTDB_FD -- $PIPE
     command rm $PIPE
     zstat -A HISTDB_INODE +inode ${HISTDB_FILE}
@@ -107,6 +108,7 @@ create index if not exists place_dir on places(dir);
 create index if not exists place_host on places(host);
 create index if not exists history_command_place on history(command_id, place_id);
 PRAGMA journal_mode = WAL;
+PRAGMA busy_timeout = ${HISTDB_BUSY_TIMEOUT_MS};
 PRAGMA synchronous=normal;
 EOF
 }
