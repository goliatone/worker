#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$ROOT"
for script in make utils.sh test.local modules/*.sh; do bash -n "$script"; done
for config in config/zsh/zshenv config/zsh/zprofile config/zsh/zshrc; do zsh -n "$config"; done
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -x make utils.sh test.local modules/*.sh
else
  printf 'ShellCheck not found; install it to run the lint check.\n' >&2
  exit 1
fi
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py' -v
